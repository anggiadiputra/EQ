PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Redis Queue Configuration
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_DB=2
REDIS_QUEUE=default
REDIS_QUEUE_HIGH=high
REDIS_QUEUE_LOW=low
REDIS_QUEUE_CERTIFICATES=certificates
REDIS_QUEUE_WAREHOUSE=warehouse
REDIS_QUEUE_RETRY_AFTER=600
REDIS_QUEUE_BLOCK_FOR=5
REDIS_READ_TIMEOUT=60

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=

# Wakif Consolidation Settings
WAKIF_CONSOLIDATION_ENABLED=true
WAKIF_DEFAULT_TAB=wakif
WAKIF_AUTO_REDIRECT=true
WAKIF_PAGINATION_PER_PAGE=15
WAKIF_CONSOLIDATION_ENABLED=true
WAKIF_DEFAULT_TAB=wakif
WAKIF_AUTO_REDIRECT=true

# ===================================
# IMAGE OPTIMIZATION SETTINGS
# ===================================

# Enable/disable image optimization
IMAGE_OPTIMIZATION_ENABLED=true

# WebP Quality (0-100, higher = better quality but larger file)
IMAGE_WEBP_QUALITY=85
IMAGE_JPEG_QUALITY=85
IMAGE_PNG_QUALITY=85

# Maximum dimensions for resizing
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_PRESERVE_ASPECT_RATIO=true

# Thumbnail settings
IMAGE_CREATE_THUMBNAILS=true
IMAGE_THUMBNAIL_WIDTH=300
IMAGE_THUMBNAIL_HEIGHT=200
IMAGE_THUMBNAIL_QUALITY=80

# Maximum upload file size (in KB)
IMAGE_MAX_FILE_SIZE=10240

# Backup settings
IMAGE_BACKUP_ENABLED=false
IMAGE_BACKUP_KEEP_DAYS=30

# Performance settings
IMAGE_MEMORY_LIMIT=256M
IMAGE_TIMEOUT=60
IMAGE_CHUNK_SIZE=5

# Logging
IMAGE_LOGGING_ENABLED=true
IMAGE_LOG_CHANNEL=daily
IMAGE_LOG_LEVEL=info

# Fallback settings
IMAGE_FALLBACK_ON_ERROR=true
IMAGE_FALLBACK_ORIGINAL_UPLOAD=true
